{
  "name": "editpanel",
  "version": "1.2.152",
  "description": "EditPanel — DaVinci Resolve companion app for the LPOS ecosystem",
  "author": "LeaderPass <tools@leaderpass.com>",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "package": "node scripts/package.mjs",
    "postinstall": "node scripts/fetch-python.mjs && node scripts/build-graphics.mjs",
    "test": "echo 'No tests'",
    "baseline:latency": "node scripts/baseline-latency.js",
    "test:recipes": "node scripts/validate-recipes.js",
    "test:routing": "node scripts/regression-worker-routing.js",
    "cache:invalidate": "node scripts/invalidate-step-cache.js",
    "test:platform-worker": "node scripts/test-platform-worker.js",
    "test:cut-through": "node scripts/test-cut-through.js"
  },
  "build": {
    "appId": "com.leaderpass.editpanel",
    "productName": "EditPanel",
    "artifactName": "EditPanel-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/.remotion/**"
    ],
    "extraResources": [
      {
        "from": "helper",
        "to": "helper",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "vendor/graphics",
        "to": "graphics",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "cut_through",
        "to": "cut_through",
        "filter": [
          "**/*",
          "!plans/**",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/tesseract.js/**",
      "**/node_modules/tesseract.js-core/**",
      "**/node_modules/@tesseract.js-data/**"
    ],
    "protocols": [
      {
        "name": "EditPanel Link",
        "schemes": [
          "lpos-editpanel"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "vendor/python-win32",
          "to": "python",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "identity": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@remotion/renderer": "4.0.542",
    "@tesseract.js-data/eng": "1.0.0",
    "basic-ftp": "5.0.5",
    "dictionary-en": "4.0.0",
    "ffmpeg-static": "5.3.0",
    "js-yaml": "4.1.1",
    "nspell": "2.1.0",
    "react": "18.0.0",
    "react-dom": "18.0.0",
    "remotion": "4.0.542",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@babel/standalone": "8.1.1",
    "@remotion/bundler": "4.0.542",
    "@remotion/layout-utils": "4.0.542",
    "@remotion/player": "4.0.542",
    "@remotion/transitions": "4.0.542",
    "electron": "42.2.0",
    "electron-builder": "^26.0.12"
  },
  "overrides": {
    "wasm-feature-detect": "1.9.0"
  }
}
